<?xml version="1.0" encoding="UTF-8"?>
<!-- FraudShield services. One Maven reactor; each service is its own Spring Boot application and image. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>
  <groupId>com.fraudshield</groupId>
  <artifactId>fraudshield-services</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>common</module>
    <module>decision</module>
    <module>case</module>
    <module>strategy</module>
    <module>copilot</module>
  </modules>

  <properties>
    <!-- The design names Java 25. This release targets 21 LTS, the toolchain it was built and tested on. -->
    <java.version>21</java.version>
    <azure-identity.version>1.18.1</azure-identity.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fraudshield</groupId>
        <artifactId>fraudshield-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.azure</groupId>
        <artifactId>azure-identity</artifactId>
        <version>${azure-identity.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>